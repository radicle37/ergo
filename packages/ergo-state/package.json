{
  "name": "ergo-state",
  "version": "0.1.0",
  "description": "Framework-agnostic store builder generating typed getters, subscribers, and actions on top of Zustand.",
  "keywords": [
    "ergo",
    "ergo-state",
    "zustand",
    "state-management",
    "store",
    "typescript",
    "selectors",
    "actions"
  ],
  "license": "MIT",
  "author": "radicle37",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radicle37/ergo.git",
    "directory": "packages/ergo-state"
  },
  "homepage": "https://github.com/radicle37/ergo/tree/main/packages/ergo-state#readme",
  "bugs": {
    "url": "https://github.com/radicle37/ergo/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./adapter-internal": {
      "types": "./build/adapter-internal.d.ts",
      "default": "./build/adapter-internal.js"
    }
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "immer": "^11.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
